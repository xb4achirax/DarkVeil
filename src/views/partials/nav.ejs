<!-- FLOATING CART BUTTON (Directly on Hero Section Top-Right) -->
<button class="cart-trigger-btn" id="open-cart-btn" aria-label="Open shopping vault">
  <svg viewBox="0 0 24 24" class="cart-trigger-icon">
    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    <line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M16 10a4 4 0 0 1-8 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  </svg>
  <span class="cart-trigger-text">VAULT</span>
  <span class="cart-count-badge" id="cart-count-badge">0</span>
</button>

<!-- CART BACKDROP OVERLAY -->
<div class="cart-overlay" id="cart-overlay"></div>

<!-- CART SLIDE-OVER DRAWER -->
<aside class="cart-drawer" id="cart-drawer" aria-label="Shopping Vault Cart" aria-hidden="true">
  <!-- Drawer Header -->
  <div class="cart-drawer-header">
    <div class="cart-drawer-title-wrap">
      <span class="cart-drawer-tag">// YOUR CART</span>
      <h2 class="cart-drawer-title chrome-text">THE VAULT</h2>
      <span class="cart-drawer-count" id="cart-drawer-items-count">0 ITEMS</span>
    </div>
    <button class="cart-close-btn" id="close-cart-btn" aria-label="Close cart">
      <svg viewBox="0 0 24 24">
        <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <!-- Drawer Body (Items) -->
  <div class="cart-drawer-body" id="cart-items-container">
    <!-- Populated dynamically via cart.js -->
  </div>

  <!-- Drawer Empty State -->
  <div class="cart-empty-view" id="cart-empty-view">
    <div class="cart-empty-icon-box">
      <svg viewBox="0 0 24 24">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        <line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="1.4"/>
        <path d="M16 10a4 4 0 0 1-8 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      </svg>
    </div>
    <h3 class="cart-empty-title">YOUR VAULT IS EMPTY</h3>
    <p class="cart-empty-subtitle">Choose your armor from our collection.</p>
    <button class="btn-chrome" id="cart-browse-btn" style="padding: 10px 24px; font-size: 0.8rem;">
      Browse Collection
    </button>
  </div>

  <!-- Drawer Footer -->
  <div class="cart-drawer-footer" id="cart-drawer-footer">
    <div class="cart-line-row">
      <span class="cart-line-label">SUBTOTAL</span>
      <span class="cart-line-value" id="cart-subtotal">0.00 MAD</span>
    </div>
    <div class="cart-line-row">
      <span class="cart-line-label">SHIPPING</span>
      <span class="cart-line-value">FREE (NATIONAL)</span>
    </div>
    <div class="cart-line-row cart-total-row">
      <span class="cart-total-label">TOTAL</span>
      <span class="cart-total-value chrome-text" id="cart-grand-total">0.00 MAD</span>
    </div>

    <!-- WhatsApp Order Button inside Cart -->
    <button class="btn-chrome cart-whatsapp-btn" id="cart-whatsapp-checkout-btn">
      <svg viewBox="0 0 24 24" class="whatsapp-icon">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.888 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" fill="currentColor"/>
      </svg>
      <span>Order on WhatsApp</span>
    </button>
    <p class="cart-disclaimer">Instant concierge order confirmed directly through WhatsApp with size and quantities.</p>
  </div>
</aside>

<!-- CART NOTIFICATION TOAST -->
<div class="cart-toast" id="cart-toast" aria-live="polite">
  <div class="cart-toast-content">
    <span class="cart-toast-icon">✓</span>
    <span class="cart-toast-message" id="cart-toast-message">Added to Vault</span>
  </div>
</div>
