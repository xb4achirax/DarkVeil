<%- include('partials/head', {
  title,
  extraCss: '<link rel="stylesheet" href="/css/admin.css">'
}) %>

<%- include('partials/nav') %>

<main class="admin-shell">
  <header class="admin-page-heading">
    <div>
      <span class="admin-eyebrow">// DARKVEIL CONTROL ROOM</span>
      <h1 class="chrome-text">ADMIN CONSOLE</h1>
      <p>Manage the collection. Your changes go live across the storefront.</p>
    </div>
    <div class="admin-heading-actions">
      <a class="admin-back-link" href="/">BACK TO SITE</a>
      <span class="admin-access-badge"><span></span> ADMIN ACCESS</span>
    </div>
  </header>

  <section class="admin-orders-panel" aria-labelledby="orders-title">
    <div class="admin-section-heading">
      <div>
        <span class="admin-eyebrow">// NEXT UP</span>
        <h2 id="orders-title">ORDERS</h2>
      </div>
      <span class="admin-coming-soon">COMING SOON</span>
    </div>
    <p>Order management will appear here in a future update. For now, customer orders continue through WhatsApp.</p>
  </section>

  <section class="admin-products-layout" aria-label="Product management">
    <section class="admin-panel admin-editor-panel">
      <div class="admin-section-heading">
        <div>
          <span class="admin-eyebrow">// COLLECTION MANAGEMENT</span>
          <h2 id="product-form-title">ADD A PRODUCT</h2>
        </div>
        <span class="admin-record-count"><%= products.length %> PRODUCTS</span>
      </div>

      <form id="admin-product-form" class="admin-product-form" novalidate>
        <input type="hidden" id="admin-product-id">
        <div class="admin-form-grid">
          <label class="admin-field admin-field-wide">
            <span>PRODUCT NAME</span>
            <input id="admin-product-name" type="text" maxlength="150" required placeholder="Product name">
          </label>
          <label class="admin-field">
            <span>CATEGORY</span>
            <select id="admin-product-category" required>
              <option value="">Choose category</option>
              <% categories.forEach(category => { %>
                <option value="<%= category.id %>"><%= category.name %> / <%= category.slug %></option>
              <% }) %>
            </select>
          </label>
          <label class="admin-field">
            <span>PRICE (MAD)</span>
            <input id="admin-product-price" type="number" min="0.01" max="99999999.99" step="0.01" required placeholder="250.00">
          </label>
          <label class="admin-field admin-field-wide">
            <span>DESCRIPTION</span>
            <textarea id="admin-product-description" rows="3" maxlength="65535" placeholder="Describe the piece"></textarea>
          </label>
        </div>

        <div class="admin-colors-heading">
          <div>
            <span class="admin-eyebrow">// VARIANTS</span>
            <h3>COLORS, SIZES & IMAGES</h3>
          </div>
          <button class="admin-secondary-btn" id="admin-add-color" type="button">+ ADD COLOR</button>
        </div>
        <div id="admin-color-list" class="admin-color-list"></div>

        <p class="admin-form-hint">Add one size per line as <code>SIZE | SKU | IN STOCK (1 or 0)</code>. Add one image URL per line. Image URLs can be local paths such as <code>/images/item.jpg</code>.</p>
        <p class="admin-feedback" id="admin-feedback" aria-live="polite"></p>

        <div class="admin-form-actions">
          <button class="admin-primary-btn" id="admin-save-product" type="submit">CREATE PRODUCT</button>
          <button class="admin-secondary-btn" id="admin-cancel-edit" type="button" hidden>CANCEL EDIT</button>
        </div>
      </form>
    </section>

    <section class="admin-panel admin-inventory-panel">
      <div class="admin-section-heading">
        <div>
          <span class="admin-eyebrow">// LIVE CATALOG</span>
          <h2>PRODUCTS</h2>
        </div>
        <span class="admin-record-count"><%= products.length %> RECORDS</span>
      </div>

      <% if (products.length) { %>
        <div class="admin-product-list">
          <% products.forEach(product => { %>
            <article class="admin-product-row">
              <img src="<%= product.image %>" alt="" loading="lazy">
              <div class="admin-product-summary">
                <h3><%= product.name %></h3>
                <p><%= product.category %> <span>·</span> <%= Number(product.price).toFixed(2) %> MAD</p>
              </div>
              <div class="admin-product-actions">
                <button class="admin-secondary-btn" type="button" data-edit-product="<%= product.id %>">EDIT</button>
                <button class="admin-delete-btn" type="button" data-delete-product="<%= product.id %>" aria-label="Delete <%= product.name %>">DELETE</button>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="admin-empty-state">
          <span>01</span>
          <p>The collection is waiting for its first piece.</p>
        </div>
      <% } %>
    </section>
  </section>
</main>

<script src="/js/admin.js"></script>
<%- include('partials/foot') %>
