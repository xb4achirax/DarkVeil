<%- include('partials/head', { title: 'DARKVEIL | More Than Clothes' ,
  extraCss: '<link rel="stylesheet" href="/css/home.css">' }) %>

  <%- include('partials/nav') %>

    <main>
      <!-- HERO SECTION -->
      <section class="hero">
        <div class="hero-bg">
          <picture>
            <source media="(max-width: 640px)" srcset="/images/hero%20mobile.png">
            <img src="/images/hero.png" alt="DARKVEIL" id="hero-img">
          </picture>
        </div>

        <div class="hero-content">
          <div class="hero-left">
            <div class="hero-title-group">
              <div class="hero-text-mask">
                <h2>More than clothes</h2>
              </div>
              <div class="hero-text-mask">
                <h2>It's a mindset</h2>
              </div>
            </div>
            <div class="hero-line hero-line-left"></div>
            <div class="hero-btn-wrap">
              <button class="hero-shop-btn" id="shop-now-btn">
                <span>Shop Now</span>
                <svg viewBox="0 0 24 24" class="hero-btn-arrow">
                  <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                    stroke-linejoin="round" />
                </svg>
              </button>
            </div>
          </div>

          <div class="hero-right">
            <p>EST. 2026</p>
            <div class="hero-line hero-line-right"></div>
          </div>
        </div>
      </section>

      <!-- PRODUCTS SECTION -->
      <section class="products-section" id="products">
        <div class="products-header">
          <span class="section-tag">// ARCHIVE 2026</span>
          <h2 class="chrome-text section-title">THE VEIL COLLECTION</h2>
          <div class="section-rule"></div>
        </div>

        <div class="products-grid">
          <% if (typeof products !=='undefined' && products.length> 0) { %>
            <% for (let i=0; i < products.length; i++) { %>
              <% const p=products[i]; %>
                <% const primaryImg=(p.images && p.images.length> 0) ? p.images[0] : (p.image || p.url ||
                  '/images/product-placeholder.jpg'); %>
                  <% const secondaryImg=(p.images && p.images.length> 1) ? p.images[1] : null; %>
                    <div class="product-card" data-product-id="<%= p.id %>"
                      data-product-name="<%= p.product || p.name %>" data-product-price="<%= p.price %>"
                      data-product-img="<%= primaryImg %>"
                      data-product-color="<%= p.color || (p.colors && p.colors[0] ? p.colors[0].name : 'Black') %>">
                      <a href="/products/<%= p.id %>" class="product-image-link">
                        <div class="product-image-wrap">
                          <img src="<%= primaryImg %>" alt="<%= p.product || p.name %>" class="product-img-primary">
                          <% if (secondaryImg) { %>
                            <img src="<%= secondaryImg %>" alt="<%= p.product || p.name %> front"
                              class="product-img-secondary">
                            <% } %>
                              <div class="product-glare"></div>
                        </div>
                      </a>
                      <div class="product-info">
                        <div class="product-header">
                          <a href="/products/<%= p.id %>" class="product-title-link">
                            <h3 class="product-title chrome-text">
                              <%= p.product || p.name %>
                            </h3>
                          </a>
                          <span class="product-price">
                            <%= p.price %> MAD
                          </span>
                        </div>
                        <p class="product-desc">
                          <%= p.description %>
                        </p>

                        <!-- Variants: Sizes & Colors -->
                        <div class="product-variants-row">
                          <div class="product-sizes" aria-label="Available sizes">
                            <% if (p.sizes && p.sizes.length> 0) { %>
                              <% p.sizes.forEach((size, idx)=> { %>
                                <button type="button" class="size-chip <%= idx === 0 ? 'selected' : '' %>"
                                  data-size="<%= size %>" aria-label="Size <%= size %>">
                                  <%= size.toUpperCase() %>
                                </button>
                                <% }); %>
                                  <% } %>
                          </div>

                          <% if (p.colors && p.colors.length> 0) { %>
                            <div class="product-colors" aria-label="Available colors">
                              <% p.colors.forEach((col, idx)=> { %>
                                <button type="button" class="color-chip <%= idx === 0 ? 'selected' : '' %>"
                                  data-color="<%= col.name %>" title="<%= col.name %>"
                                  aria-label="Color <%= col.name %>">
                                  <span class="color-swatch-dot" style="background-color: <%= col.hex %>;"></span>
                                  <span class="color-chip-text">
                                    <%= col.name %>
                                  </span>
                                </button>
                                <% }); %>
                            </div>
                            <% } %>
                        </div>

                        <!-- Add to Cart Button -->
                        <button type="button" class="btn-chrome add-to-cart-btn" data-product-id="<%= p.id %>">
                          <span>Add to Cart</span>
                          <svg viewBox="0 0 24 24">
                            <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                              stroke-linejoin="round" />
                          </svg>
                        </button>
                      </div>
                    </div>
                    <% } %>
                      <% } %>
        </div>
      </section>


      <!-- CLOSING SECTION -->
      <section class="closing-section">
        <p class="closing-statement">Embrace the dark. Redefine the streets. You are the veil.</p>
        <footer>
          <p>DARKVEIL</p>
          <p>&copy; DARKVEIL</p>
        </footer>
      </section>
    </main>

    <script>
      // WhatsApp number configuration (can be pulled from env in backend and passed to view)
      const WHATSAPP_NUMBER = "<%= typeof whatsappNumber !== 'undefined' ? whatsappNumber : '212600000000' %>"; // The WhatsApp number


      // GSAP Animations
      document.addEventListener("DOMContentLoaded", (event) => {
        // 1. Hero Page-Load Intro
        const tl = gsap.timeline();

        // Fade out black screen (assumed background is black, content fades in)
        tl.to("#hero-img", {
          scale: 1,
          duration: 2.5,
          ease: "power2.out"
        }, 0)
          .to(".hero-text-mask h2", {
            y: "0%",
            opacity: 1,
            duration: 1.2,
            stagger: 0.2,
            ease: "power3.out"
          }, 0.5)
          .to(".hero-line-left", {
            width: "58px",
            duration: 0.9,
            opacity: 1,
            ease: "power2.out"
          }, 1.1)
          .to(".hero-line-right", {
            width: "58px",
            duration: 0.9,
            opacity: 1,
            ease: "power2.out"
          }, 1.1)
          .to(".hero-right p", {
            opacity: 1,
            duration: 1
          }, 1.5)
          .to(".hero-btn-wrap", {
            opacity: 1,
            y: 0,
            duration: 1,
            ease: "power2.out"
          }, 1.8);

        // 2. Scroll Parallax for Hero
        gsap.to(".hero-bg", {
          y: "30%",
          opacity: 0.3,
          ease: "none",
          scrollTrigger: {
            trigger: ".hero",
            start: "top top",
            end: "bottom top",
            scrub: true
          }
        });

        // 3. Subtle Mouse-Move Parallax for Desktop
        if (matchMedia('(pointer: fine)').matches) {
          const heroBg = document.querySelector('.hero-bg');
          window.addEventListener('mousemove', (e) => {
            const x = (e.clientX / window.innerWidth - 0.5) * 20;
            const y = (e.clientY / window.innerHeight - 0.5) * 20;
            gsap.to(heroBg, {
              x: -x,
              y: -y,
              duration: 1,
              ease: "power2.out"
            });
          });
        }

        // 4. Smooth Scroll for Shop Now Button
        document.getElementById('shop-now-btn').addEventListener('click', () => {
          lenis.scrollTo('#products');
        });

        // 5. Product Section Reveal on Scroll
        gsap.utils.toArray('.product-card').forEach((card, i) => {
          gsap.to(card, {
            opacity: 1,
            y: 0,
            duration: 1,
            ease: "power3.out",
            scrollTrigger: {
              trigger: card,
              start: "top 85%",
            }
          });
        });

        // 6. 3D Tilt Effect on Product Images
        if (matchMedia('(pointer: fine)').matches) {
          const productImages = document.querySelectorAll('.product-image-wrap');
          productImages.forEach(wrap => {
            const imgs = wrap.querySelectorAll('img');
            const glare = wrap.querySelector('.product-glare');

            wrap.addEventListener('mousemove', (e) => {
              const rect = wrap.getBoundingClientRect();
              const x = e.clientX - rect.left;
              const y = e.clientY - rect.top;

              const centerX = rect.width / 2;
              const centerY = rect.height / 2;

              const rotateX = ((y - centerY) / centerY) * -10;
              const rotateY = ((x - centerX) / centerX) * 10;

              imgs.forEach(img => {
                gsap.to(img, {
                  rotationX: rotateX,
                  rotationY: rotateY,
                  transformPerspective: 1000,
                  ease: "power1.out",
                  duration: 0.5
                });
              });

              gsap.to(glare, {
                background: `radial-gradient(circle at ${x}px ${y}px, rgba(255,255,255,0.2) 0%, transparent 50%)`,
                duration: 0
              });
            });

            wrap.addEventListener('mouseleave', () => {
              imgs.forEach(img => {
                gsap.to(img, {
                  rotationX: 0,
                  rotationY: 0,
                  ease: "power3.out",
                  duration: 1
                });
              });
            });
          });
        }
      });
    </script>

    <%- include('partials/foot') %>