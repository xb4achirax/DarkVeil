<%- include('partials/head', { title: (product.name || product.product || 'Collection' ) + ' | DARKVEIL' ,
  extraCss: '<link rel="stylesheet" href="/css/product.css">' }) %>

  <%- include('partials/nav') %>

    <main>
      <section class="pdp">
        <!-- LEFT: Image Gallery -->
        <div class="pdp-gallery" id="pdp-gallery">
          <div class="pdp-gallery-track">
            <% if (product.images && product.images.length> 0) { %>
              <% product.images.forEach((img, idx)=> { %>
                <div class="pdp-gallery-slide <%= idx === 0 ? 'active' : '' %>">
                  <img src="<%= img %>" alt="<%= product.name || product.product %> - View <%= idx + 1 %>">
                </div>
                <% }); %>
                  <% } else { %>
                    <div class="pdp-gallery-slide active">
                      <img src="<%= product.image || product.url || '/images/product-placeholder.jpg' %>"
                        alt="<%= product.name || product.product %>">
                    </div>
                    <% } %>
                      <div class="pdp-gallery-glare"></div>
          </div>

          <% if (product.images && product.images.length> 1) { %>
            <div class="pdp-gallery-thumbs">
              <% product.images.forEach((img, idx)=> { %>
                <div class="pdp-thumb <%= idx === 0 ? 'active' : '' %>" data-slide="<%= idx %>">
                  <img src="<%= img %>" alt="Thumbnail <%= idx + 1 %>">
                </div>
                <% }); %>
            </div>
            <% } %>
        </div>

        <!-- RIGHT: Product Details & Purchase Actions -->
        <div class="pdp-info">
          <a href="/" class="pdp-back">
            <svg viewBox="0 0 24 24">
              <path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                stroke-linejoin="round" />
            </svg>
            <span>Back</span>
          </a>

          <span class="pdp-tag">// <%= (product.category || 'COLLECTION' ).toUpperCase() %></span>

          <h1 class="pdp-name chrome-text">
            <%= product.name || product.product %>
          </h1>

          <p class="pdp-price">
            <%= product.price %> MAD
          </p>

          <div class="pdp-divider"></div>

          <p class="pdp-description">
            <%= product.description %>
          </p>

          <!-- VARIANT SELECTORS (COLORS & SIZES) -->
          <div class="pdp-options-cluster">
            <!-- COLORS (Only available in DB) -->
            <% if (product.colors && product.colors.length> 0) { %>
              <div class="pdp-option-group">
                <div class="pdp-group-header">
                  <span class="pdp-group-label">Color</span>
                  <span class="pdp-active-color-name" id="pdp-color-name">
                    <%= product.colors[0].name.toUpperCase() %>
                  </span>
                </div>
                <div class="pdp-color-chips" id="pdp-colors">
                  <% product.colors.forEach((col, idx)=> { %>
                    <button type="button" class="pdp-color-chip <%= idx === 0 ? 'selected' : '' %>"
                      data-color="<%= col.name %>" data-hex="<%= col.hex %>" aria-label="Color <%= col.name %>"
                      title="<%= col.name %>">
                      <span class="pdp-color-circle" style="background-color: <%= col.hex %>;"></span>
                      <span class="pdp-color-chip-text">
                        <%= col.name %>
                      </span>
                    </button>
                    <% }); %>
                </div>
              </div>
              <% } %>

                <!-- SIZES (Available in DB) -->
                <% const hasColorVariants = product.colors && product.colors.length> 0; const initialSizes =
                  hasColorVariants ? (product.colors[0].sizes || []) : ((product.sizes && product.sizes.length> 0) ?
                  product.sizes : ['S', 'M', 'L', 'XL']); %>
                  <div class="pdp-option-group">
                    <div class="pdp-group-header">
                      <span class="pdp-group-label">Size</span>
                      <span class="pdp-group-meta">Oversized Fit</span>
                    </div>
                    <div class="pdp-size-chips" id="pdp-sizes">
                      <% if (hasColorVariants) { product.colors.forEach((color, colorIdx)=> {
                        (color.sizes || []).forEach((size, sizeIdx)=> { %>
                          <button type="button" class="pdp-size-chip <%= colorIdx === 0 && sizeIdx === 0 ? 'selected' : '' %>"
                            data-size="<%= size %>" data-color="<%= color.name %>" <%= colorIdx === 0 ? '' : 'hidden' %>
                            aria-label="Size <%= size %>">
                            <%= size.toUpperCase() %>
                          </button>
                          <% }); }); } else { initialSizes.forEach((size, idx)=> { %>
                            <button type="button" class="pdp-size-chip <%= idx === 0 ? 'selected' : '' %>"
                              data-size="<%= size %>" aria-label="Size <%= size %>">
                              <%= size.toUpperCase() %>
                            </button>
                            <% }); } %>
                    </div>
                  </div>
          </div>

          <!-- ACTION BUTTONS: QUANTITY & ADD TO CART -->
          <div class="pdp-actions-row">
            <!-- Quantity Stepper -->
            <div class="pdp-qty-stepper">
              <button type="button" class="pdp-qty-btn" id="pdp-qty-minus" aria-label="Decrease quantity">−</button>
              <span class="pdp-qty-val" id="pdp-qty-val">1</span>
              <button type="button" class="pdp-qty-btn" id="pdp-qty-plus" aria-label="Increase quantity">+</button>
            </div>

            <!-- Add to Cart CTA -->
            <button type="button" class="pdp-add-btn btn-chrome" id="pdp-add-to-cart"
              <%= initialSizes.length === 0 ? 'disabled' : '' %>
              data-product-id="<%= product.id %>" data-product-name="<%= product.name || product.product %>"
              data-product-price="<%= product.price %>"
              data-product-img="<%= product.image || (product.images && product.images[0]) || '/images/product-placeholder.jpg' %>">
              <svg viewBox="0 0 24 24" class="pdp-add-icon">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round" fill="none" />
                <line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="1.6" />
                <path d="M16 10a4 4 0 0 1-8 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                  stroke-linejoin="round" fill="none" />
              </svg>
              <span class="pdp-add-text">Add to Cart</span>
              <span class="pdp-add-separator">·</span>
              <span class="pdp-add-price">
                <%= product.price %> MAD
              </span>
            </button>
          </div>

          <!-- Product Meta Strip -->
          <div class="pdp-meta">
            <div class="pdp-meta-item">
              <span class="pdp-meta-label">Selected Color</span>
              <span class="pdp-meta-value" id="pdp-meta-color-val">
                <%=product.colors[0].name
                  %>
              </span>
            </div>
            <div class="pdp-meta-item">
              <span class="pdp-meta-label">Category</span>
              <span class="pdp-meta-value">
                <%= product.category || 'Tops' %>
              </span>
            </div>
            <div class="pdp-meta-item">
              <span class="pdp-meta-label">Shipping</span>
              <span class="pdp-meta-value">Free Delivery</span>
            </div>
          </div>
        </div>
      </section>
    </main>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        /* ── Image Gallery Switching ── */
        const slides = document.querySelectorAll('.pdp-gallery-slide');
        const thumbs = document.querySelectorAll('.pdp-thumb');

        thumbs.forEach(thumb => {
          thumb.addEventListener('click', () => {
            const idx = parseInt(thumb.dataset.slide);
            slides.forEach(s => s.classList.remove('active'));
            thumbs.forEach(t => t.classList.remove('active'));
            if (slides[idx]) slides[idx].classList.add('active');
            thumb.classList.add('active');
          });
        });

        /* ── Color Selection ── */
        const colorChips = document.querySelectorAll('.pdp-color-chip');
        const colorNameLabel = document.getElementById('pdp-color-name');
        const metaColorVal = document.getElementById('pdp-meta-color-val');
        const sizeChips = document.querySelectorAll('.pdp-size-chip');
        const addBtn = document.getElementById('pdp-add-to-cart');

        colorChips.forEach(chip => {
          chip.addEventListener('click', () => {
            colorChips.forEach(c => c.classList.remove('selected'));
            chip.classList.add('selected');
            const selectedColor = chip.dataset.color || 'Black';
            if (colorNameLabel) colorNameLabel.textContent = selectedColor.toUpperCase();
            if (metaColorVal) metaColorVal.textContent = selectedColor;

            let firstAvailableSize = null;
            sizeChips.forEach(sizeChip => {
              const isAvailable = sizeChip.dataset.color === selectedColor;
              sizeChip.hidden = !isAvailable;
              sizeChip.classList.remove('selected');
              if (isAvailable && !firstAvailableSize) firstAvailableSize = sizeChip;
            });
            if (firstAvailableSize) firstAvailableSize.classList.add('selected');
            if (addBtn) addBtn.disabled = !firstAvailableSize;
          });
        });

        /* ── Size Selection ── */
        sizeChips.forEach(chip => {
          chip.addEventListener('click', () => {
            if (chip.hidden) return;
            sizeChips.forEach(c => c.classList.remove('selected'));
            chip.classList.add('selected');
          });
        });

        /* ── Quantity Counter ── */
        let quantity = 1;
        const qtyVal = document.getElementById('pdp-qty-val');
        const minusBtn = document.getElementById('pdp-qty-minus');
        const plusBtn = document.getElementById('pdp-qty-plus');

        if (minusBtn && plusBtn && qtyVal) {
          minusBtn.addEventListener('click', () => {
            if (quantity > 1) {
              quantity--;
              qtyVal.textContent = quantity;
            }
          });
          plusBtn.addEventListener('click', () => {
            if (quantity < 10) {
              quantity++;
              qtyVal.textContent = quantity;
            }
          });
        }

        /* ── Add to Cart Click Handler ── */
        if (addBtn) {
          addBtn.addEventListener('click', () => {
            const selectedSizeChip = document.querySelector('.pdp-size-chip.selected:not([hidden])');
            if (!selectedSizeChip) return;
            const size = selectedSizeChip.dataset.size;

            const selectedColorChip = document.querySelector('.pdp-color-chip.selected');
            const color = selectedColorChip ? selectedColorChip.dataset.color : (colorChips[0]?.dataset.color || 'Black');

            const item = {
              id: addBtn.dataset.productId,
              name: addBtn.dataset.productName,
              price: parseFloat(addBtn.dataset.productPrice),
              image: addBtn.dataset.productImg,
              size: size,
              color: color,
              qty: quantity
            };

            if (window.DarkVeilCart && typeof window.DarkVeilCart.addItem === 'function') {
              window.DarkVeilCart.addItem(item);
            } else {
              try {
                let cart = JSON.parse(localStorage.getItem('DARKVEIL_CART_V1') || '[]');
                const existing = cart.find(c => c.id == item.id && c.size == item.size && c.color == item.color);
                if (existing) {
                  existing.qty = (existing.qty || 1) + item.qty;
                } else {
                  cart.push(item);
                }
                localStorage.setItem('DARKVEIL_CART_V1', JSON.stringify(cart));
              } catch (e) {
                console.error(e);
              }
            }

            // Button Visual Feedback
            const originalHtml = addBtn.innerHTML;
            addBtn.innerHTML = `
        <span style="letter-spacing:0.18em; font-weight:600; color:#050505;">Added to Vault ✓</span>
      `;
            addBtn.style.background = '#ffffff';
            addBtn.style.color = '#050505';
            addBtn.style.boxShadow = '0 0 30px rgba(255, 255, 255, 0.4)';

            setTimeout(() => {
              addBtn.innerHTML = originalHtml;
              addBtn.style.background = '';
              addBtn.style.color = '';
              addBtn.style.boxShadow = '';
            }, 1600);
          });
        }

        /* ── Fast Smooth Page Entrance ── */
        if (typeof gsap !== 'undefined') {
          gsap.from(".pdp-gallery", { opacity: 0, x: -30, duration: 0.7, ease: "power2.out" });
          gsap.from([".pdp-tag", ".pdp-name", ".pdp-price", ".pdp-divider", ".pdp-description"], {
            opacity: 0,
            y: 12,
            stagger: 0.06,
            duration: 0.5,
            ease: "power2.out"
          });
          gsap.from([".pdp-options-cluster", ".pdp-actions-row", ".pdp-meta"], {
            opacity: 0,
            y: 10,
            stagger: 0.08,
            duration: 0.5,
            delay: 0.15,
            ease: "power2.out"
          });
        }

        /* ── Gallery Glare Mousemove Effect ── */
        if (matchMedia('(pointer: fine)').matches) {
          const gallery = document.querySelector('.pdp-gallery');
          const glare = document.querySelector('.pdp-gallery-glare');
          if (gallery && glare) {
            gallery.addEventListener('mousemove', (e) => {
              const rect = gallery.getBoundingClientRect();
              const x = e.clientX - rect.left;
              const y = e.clientY - rect.top;
              glare.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(255,255,255,0.12) 0%, transparent 55%)`;
            });
          }
        }
      });
    </script>

    <%- include('partials/foot') %>